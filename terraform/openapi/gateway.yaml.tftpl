swagger: "2.0"
info:
  title: tech-challenge
  description: Entrada no apex. O path inteiro segue para o Gateway do GKE.
  version: "1.0.0"
host: ${entry_hostname}
schemes:
  - https
produces:
  - application/json
consumes:
  - application/json
paths:
  /orcamento/webhook/mercado-pago:
    post:
      operationId: orcamentoWebhookMercadoPago
      summary: Webhook Mercado Pago, anonimo neste gateway
      x-google-backend:
        address: ${api_backend_url}
        path_translation: APPEND_PATH_TO_ADDRESS
        disable_auth: true
        deadline: 60.0
      responses:
        "200":
          description: OK
%{ for prefix, id in prefixes ~}
  /${prefix}:
%{ for method in methods ~}
    ${method}:
      operationId: ${id}${title(method)}
      x-google-backend:
        address: ${api_backend_url}
        path_translation: APPEND_PATH_TO_ADDRESS
        disable_auth: true
        deadline: 60.0
      responses:
        "200":
          description: OK
%{ endfor ~}
  /${prefix}/{path=**}:
    parameters:
      - name: path
        in: path
        required: true
        type: string
%{ for method in methods ~}
    ${method}:
      operationId: ${id}Proxy${title(method)}
      x-google-backend:
        address: ${api_backend_url}
        path_translation: APPEND_PATH_TO_ADDRESS
        disable_auth: true
        deadline: 60.0
      responses:
        "200":
          description: OK
%{ endfor ~}
%{ endfor ~}
